{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Write(README.md)",
      "Shell(ls)",
      "Shell(pwd)",
      "Shell(cat)",
      "Shell(head)",
      "Shell(tail)",
      "Shell(grep)",
      "Shell(rg)",
      "Shell(find)",
      "Shell(sed)",
      "Shell(awk)",
      "Shell(wc)",
      "Shell(pytest)",
      "Shell(ruff)",
      "Shell(mypy)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(.git/**)",
      "Write(.github/**)",
      "Write(ops/**)",
      "Write(runtime/**)",
      "Shell(git)",
      "Shell(gh)",
      "Shell(curl)",
      "Shell(wget)",
      "Shell(ssh)",
      "Shell(scp)",
      "Shell(sudo)",
      "Shell(rm)",
      "Shell(mv)",
      "Shell(cp)",
      "Shell(chmod)",
      "Shell(chown)",
      "Shell(launchctl)",
      "Shell(security)",
      "Shell(bash)",
      "Shell(zsh)",
      "Shell(sh)",
      "Shell(env)",
      "Shell(printenv)",
      "WebFetch(*)",
      "Mcp(*:*)"
    ]
  }
}
